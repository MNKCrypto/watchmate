# Copy this file to .env and fill in your own values. .env is git-ignored.
# Variable name matches Meta Model API docs.
MODEL_API_KEY=your-meta-model-api-key-here

# Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=your-bot-token

# Private demo: Telegram chat ids allowed to use the bot (comma-separated). Empty = nobody.
ALLOWED_CHAT_IDS=123456789,987654321
